{
  "name": "strudel-workshop-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first interactive notebook for teaching live-coding music with Strudel",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node server.mjs --open",
    "serve": "node server.mjs",
    "verify": "node scripts/verify-offline.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
